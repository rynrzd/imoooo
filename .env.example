# =============================================================
# Nireo — copiez ce fichier vers .env.local et renseignez vos valeurs.
# .env.local n'est jamais commité.
# =============================================================

# ---------- Supabase (Projet → Settings → API Keys) ----------

# URL du projet, SANS chemin (/rest/v1, /auth/v1… sont interdits ici)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé « publishable » uniquement (sb_publishable_…)
# ⚠️ JAMAIS de clé secrète (sb_secret_…) ni de service_role ici.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre-cle-fictive

# Clé secrète du projet (sb_secret_…) — SERVEUR UNIQUEMENT.
# Requise par le webhook Stripe pour écrire la table subscriptions.
# Jamais préfixée NEXT_PUBLIC_, jamais exposée au navigateur.
SUPABASE_SECRET_KEY=sb_secret_votre-cle-fictive

# URL du site (redirections des e-mails d'authentification et de Stripe)
# OBLIGATOIRE en production Vercel : le build échoue si elle manque.
# ⚠️ https://immopilot-silk.vercel.app n'est PAS accessible depuis un téléphone : pour un
# test mobile, utilisez une URL de preview Vercel (voir AUTH_SETUP.md).
NEXT_PUBLIC_SITE_URL=https://nireo.fr

# Mode démo (données fictives, AUCUNE authentification). Sans les variables
# Supabase, le démarrage ÉCHOUE sauf si cette variable vaut explicitement true.
# Ne jamais activer en production.
NEXT_PUBLIC_DEMO_MODE=false

# Environnement applicatif affiché/loggué (development | production)
NEXT_PUBLIC_APP_ENV=production

# ---------- Stripe (Dashboard → Developers → API keys) ----------
# Tant que ces variables sont vides, l'application fonctionne normalement
# et affiche « paiement bientôt disponible » sur la page Abonnement.

# Clé secrète (sk_test_… en test, sk_live_… en production) — SERVEUR UNIQUEMENT.
STRIPE_SECRET_KEY=

# Clé publiable (pk_test_… / pk_live_…) — la seule exposable au navigateur.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret de signature du webhook (whsec_…) — Dashboard → Developers → Webhooks.
# Endpoint à créer : https://votre-domaine.fr/api/stripe/webhook
# ⚠️ Événements à cocher (en mode TEST *et* LIVE) — sinon pas de commission
# partenaire ni de reversal :
#   checkout.session.completed
#   customer.subscription.created / updated / deleted
#   invoice.paid                 ← indispensable au calcul de commission
#   invoice.payment_failed
#   charge.refunded              ← indispensable au retrait de commission (reversal)
STRIPE_WEBHOOK_SECRET=

# Identifiants de prix (price_…) des produits à créer dans Stripe.
# Abonnements mensuels récurrents (source des plans : src/config/plans.ts) :
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Offre Fondateur — paiements UNIQUES (one-time) :
# palier 1 = places 1-50 (299 €), palier 2 = places 51-100 (499 €).
STRIPE_PRICE_FOUNDER_T1=
STRIPE_PRICE_FOUNDER_T2=

# ---------- E-mails (optionnel — aucun envoi tant que vide) ----------
# Voir docs/EMAILS.md pour la configuration complète (domaine, DNS, SMTP
# Supabase Auth). Fournisseur recommandé : Resend.
# EMAIL_PROVIDER : resend | brevo | postmark
EMAIL_PROVIDER=resend

# Expéditeur : nom affiché + adresse (le domaine doit être vérifié chez le
# fournisseur). En développement Resend sans domaine vérifié, utilisez
# onboarding@resend.dev (envoi vers votre propre adresse uniquement).
EMAIL_FROM_NAME=Nireo
EMAIL_FROM_ADDRESS=

# (Compatibilité : EMAIL_FROM « Nom <adresse@domaine.fr> » reste accepté
# si EMAIL_FROM_ADDRESS est vide.)
EMAIL_FROM=

# Boîte qui reçoit les messages du formulaire de contact.
SUPPORT_EMAIL=

# Clé API du fournisseur choisi — SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC_.
RESEND_API_KEY=
BREVO_API_KEY=
POSTMARK_SERVER_TOKEN=

# Secret du planificateur (relances automatiques /api/cron/rent-reminders).
# Sans lui, les relances automatiques restent inactives.
CRON_SECRET=

# ---------- Affiliation : signature du cookie d'attribution ----------
# Le cookie « nireo_ref » (partenaire ayant amené le visiteur) est HttpOnly,
# mais rien n'empêche quelqu'un de le fabriquer dans SON navigateur pour
# s'attribuer lui-même à un partenaire. Ce secret le signe, et rend du même
# coup la date du premier clic digne de confiance.
# Sans valeur, la signature est simplement INACTIVE — l'affiliation continue
# de fonctionner, et /admin/parametres affiche l'état réel.
# Générer une valeur : openssl rand -hex 32
REF_COOKIE_SECRET=

# ---------- Anti-force brute des formulaires d'authentification ----------
# La connexion part du NAVIGATEUR vers Supabase : aucune limite posée dans une
# route Nireo ne tiendrait, il suffirait d'appeler Supabase directement. Le
# seul verrou non contournable est celui que GoTrue applique lui-même — d'où
# le CAPTCHA.
#
# TANT QUE CETTE VARIABLE EST VIDE, RIEN NE CHANGE : aucun widget, aucun appel
# à Cloudflare, la CSP n'ouvre même pas le domaine. Nireo se comporte
# exactement comme aujourd'hui.
#
# Pour ACTIVER la protection, les DEUX étapes sont nécessaires :
#   1. Cloudflare → Turnstile → Add site (gratuit, sans carte).
#      Type de widget « Managed » : invisible pour un visiteur normal.
#      Domaines à déclarer : nireo.fr, www.nireo.fr, et localhost pour tester.
#      Copier la « Site Key » ci-dessous, garder la « Secret Key » pour l'étape 2.
#   2. Supabase → Authentication → Attack Protection → Enable CAPTCHA
#      protection → fournisseur « Turnstile by Cloudflare » → coller la
#      SECRET key (elle ne doit JAMAIS se retrouver ici, ni dans le code).
#
# Si l'étape 1 est faite sans l'étape 2 : le widget s'affiche mais Supabase
# ignore le jeton (aucune protection, aucune casse). Si l'étape 2 est faite
# sans l'étape 1 : TOUTE connexion est refusée. Faire les deux, dans cet ordre.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Nireo ID (second produit) ----------
# Nireo ID n'exige AUCUNE variable supplémentaire : il réutilise Supabase,
# l'authentification et le fournisseur e-mail de Nireo.
#
# Facultatif — « poivre » des empreintes d'identifiants (numéro de série,
# IMEI) servant à détecter les doublons. S'il est défini, une fuite de la
# base ne permet pas de retrouver un identifiant par simple dictionnaire.
# ⚠️ Le modifier après coup rend les empreintes existantes incomparables :
# à fixer une fois pour toutes, avant la mise en production.
NIREO_ID_FINGERPRINT_PEPPER=

# Bilans automatiques : la route /api/cron/nireo-id-checkups réutilise
# CRON_SECRET (ci-dessus). Sans CRON_SECRET, aucun bilan n'est envoyé
# automatiquement ; les bilans manuels restent disponibles.

# ---------- Abonnements Nireo ID (indépendants de Nireo Immo) ----------
# Price IDs Stripe PROPRES à Nireo ID. Tant qu'ils sont vides, le bouton
# de paiement affiche « Bientôt disponible » : aucun compte n'est marqué
# payant, aucun paiement n'est simulé.
# Créez ces produits dans Stripe (Products → Add product) :
#   Famille              — 29 € / an
#   Entreprise Starter   — 19 € / mois
#   Entreprise Équipe    — 49 € / mois
#   Atelier Pro          — 29 € / mois et par établissement
NIREO_ID_STRIPE_PRICE_FAMILLE=
NIREO_ID_STRIPE_PRICE_ENTREPRISE_STARTER=
NIREO_ID_STRIPE_PRICE_ENTREPRISE_EQUIPE=
NIREO_ID_STRIPE_PRICE_ATELIER_PRO=

# Secret de signature du webhook Nireo ID (endpoint DISTINCT de celui de
# Nireo Immo) : Stripe → Developers → Webhooks → /api/nireo-id/stripe/webhook
# Événements à cocher : checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted
NIREO_ID_STRIPE_WEBHOOK_SECRET=

# ---------- Supervision des erreurs (serveur uniquement) ----------
# Collecteur HTTP qui reçoit les erreurs serveur ET navigateur, en JSON
# (voir src/lib/monitoring.ts pour le format exact de l'événement).
# Fonctionne avec n'importe quel service acceptant un POST JSON :
# Better Stack, Axiom, Logtail, un relais Sentry, un webhook Slack/Discord…
#
# ABSENTE = supervision INACTIVE : rien n'est envoyé, rien n'est simulé.
# /api/health renvoie alors « monitoring: false » — c'est la façon de
# vérifier, après déploiement, que la supervision est réellement branchée.
#
# Ne JAMAIS préfixer par NEXT_PUBLIC_ : l'URL contient en général un jeton
# d'ingestion, et le navigateur passe volontairement par le relais serveur
# /api/monitoring/report pour ne pas l'exposer.
MONITORING_WEBHOOK_URL=
